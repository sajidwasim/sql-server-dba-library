{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL Server DBA Script Metadata",
  "type": "object",
  "required": ["script_id", "title", "status", "operation", "scope", "supported_targets", "required_permissions", "test_profile"],
  "properties": {
    "script_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 8},
    "status": {"enum": ["quarantine", "candidate", "verified", "deprecated"]},
    "operation": {"enum": ["read", "change", "destructive"]},
    "scope": {"enum": ["instance", "database", "object", "azure-resource", "host"]},
    "supported_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_permissions": {"type": "array", "items": {"type": "string"}},
    "test_profile": {"type": "string"},
    "idempotent": {"type": ["boolean", "null"]},
    "rollback": {"type": ["string", "null"]},
    "owner": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "last_reviewed": {"type": ["string", "null"], "format": "date"}
  },
  "additionalProperties": true
}
